<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera is a plain-HTTP Wi-Fi AP, so cleartext is required. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Required for the WifiLock held while the RTSP live view runs: without it
         the Wi-Fi stack sleeps between frames and the preview drifts seconds
         behind. Released as soon as the preview closes. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!-- 1. Entry point: decide whether the camera is reachable. -->
        <activity
            android:name=".ConnectActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Shoot / history chooser. -->
        <activity android:name=".HomeActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 3. Photo / video / preview toggle. -->
        <activity android:name=".CaptureActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 4. Time-ordered media list + download. -->
        <activity android:name=".HistoryActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 5. Full-screen preview of one photo / video. -->
        <activity android:name=".PreviewActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 6. Photo / video resolution picker (cmd 1002 / 2002). -->
        <activity android:name=".QualityActivity" android:exported="false" android:screenOrientation="portrait" />
    </application>

</manifest>
